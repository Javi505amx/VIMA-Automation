---
import Container from "../components/Container.astro"
import Sectionhead from "./sectionhead.astro"
---

<Container>
  <Sectionhead>
    <Fragment slot='title'>Nuestras marcas</Fragment>
    <Fragment slot='desc'
      >Trabajamos con las mejores marcas del mercado</Fragment
    >
  </Sectionhead>

  <div class='py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div
        class='mx-auto grid max-w-lg grid-cols-2 items-center gap-x-8 gap-y-12 sm:max-w-xl sm:grid-cols-3 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5'
      >
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/AB.webp'
          alt='Logo de Allen Bradley'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/Siemens.png'
          alt='Logo de SIEMENS'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/OMRON.webp'
          alt='Logo de Omron'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/Schneider.webp'
          alt='Logo de Schneider'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/Mitsubishi.webp'
          alt='Logo de Mitsubishi'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/Honeywell.jpg'
          alt='Logo de Honeywell'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/delta.jpg'
          alt='Logo de Delta'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/keyence.jpg'
          alt='Logo de Keyence'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/eanda.webp'
          alt='Logo de ENDRES+HAUSER'
          width='158'
          height='48'
        />
        <img
          class='col-span-1 max-h-12 w-full object-contain hover:scale-110 transition-transform duration-300 ease-in-out'
          src='/images/sick.webp'
          alt='Logo de SICK'
          width='158'
          height='48'
        />
      </div>
    </div>
  </div>
</Container>
