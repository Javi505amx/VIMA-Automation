---
import '@fontsource-variable/onest'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Navbar from '../components/navbar/navbar.astro'
import Footer from '../components/footer.astro';
import WhatsappButton from '../components/ui/icons/WhatsappButton.astro';
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='es'>
  <head>
    <!-- HTML Meta Tags -->
<title>VIMA Automation</title>
<meta name="description" content="Soluciones de control y automatización industrial. PLCs Guadalajara">

<!-- Facebook Meta Tags -->
<meta property="og:url" content="https://vima-automation.store/">
<meta property="og:type" content="website">
<meta property="og:title" content="VIMA Automation">
<meta property="og:description" content="Soluciones de control y automatización industrial. PLCs Guadalajara">
<meta property="og:image" content="https://opengraph.b-cdn.net/production/images/a411022a-1280-46d0-90fa-c96b3bb496b5.png?token=FiPEpsBPkk9RvYeJT0taGEPhJcXOcXjEsZdTRBb1CsY&height=630&width=1200&expires=33290091798">

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta property="twitter:domain" content="vima-automation.store">
<meta property="twitter:url" content="https://vima-automation.store/">
<meta name="twitter:title" content="VIMA Automation">
<meta name="twitter:description" content="Soluciones de control y automatización industrial. PLCs Guadalajara">
<meta name="twitter:image" content="https://opengraph.b-cdn.net/production/images/a411022a-1280-46d0-90fa-c96b3bb496b5.png?token=FiPEpsBPkk9RvYeJT0taGEPhJcXOcXjEsZdTRBb1CsY&height=630&width=1200&expires=33290091798">


    <title>{title}</title>
  </head>
  <body>
    <!-- <Header /> -->
<Navbar />
    <slot />
    <Footer />
<WhatsappButton />

    <style is:global>
      :root {
        color-scheme: light;
      }
      html {
        font-family: 'Onest Variable',system-ui, sans-serif;
      }
      body {
        /* background: #1f2937; */
        /* display: flex; */
        /* flex-direction: column; */
        /*justify-content: center; */
        min-height: 100vh;
        font-family: 'Onest Variable', sans-serif;
      }
      </style>

</body>
</html>